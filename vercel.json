{
  "services": {
    "main_app": {
      "root": "app/",
      "framework": "vite"
    },
    "sub_app": {
      "root": "myapp/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/myapp/(.*)",
      "destination": { "service": "sub_app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "main_app" }
    }
  ]
}
